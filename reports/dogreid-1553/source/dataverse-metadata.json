{"status":"OK","data":{"id":13105717,"identifier":"DVN/LVTRLG","persistentUrl":"https://doi.org/10.7910/DVN/LVTRLG","protocol":"doi","authority":"10.7910","separator":"/","publisher":"Harvard Dataverse","publicationDate":"2026-04-17","storageIdentifier":"s3://10.7910/DVN/LVTRLG","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":993,"datasetType":"dataset","locks":[],"latestVersion":{"id":729962,"datasetId":13105717,"datasetPersistentId":"doi:10.7910/DVN/LVTRLG","datasetType":"dataset","storageIdentifier":"s3://10.7910/DVN/LVTRLG","versionNumber":3,"internalVersionNumber":10,"versionMinorNumber":2,"versionState":"RELEASED","latestVersionPublishingState":"RELEASED","UNF":"UNF:6:6ZVccIIn2A18JHuowy7K1A==","lastUpdateTime":"2026-05-06T18:41:13Z","releaseTime":"2026-05-06T18:41:13Z","createTime":"2026-05-05T14:30:54Z","publicationDate":"2026-04-17","citationDate":"2026-04-17","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":993,"license":{"name":"CC0 1.0","uri":"http://creativecommons.org/publicdomain/zero/1.0","iconUri":"https://licensebuttons.net/p/zero/1.0/88x31.png","rightsIdentifier":"CC0-1.0","rightsIdentifierScheme":"SPDX","schemeUri":"https://spdx.org/licenses/","languageCode":"en"},"fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"DogReID-1553: A Large-Scale Dog Re-Identification Video Dataset"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Marko Medved"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"https://ror.org/05bhada84"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Sebastijan Trojer"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Ljubljana"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Žan Mervič"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Ljubljana"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Erik Štrumbelj"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Ljubljana"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Medved, Marko"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Nara Institute of Science and Technology"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"marko.medved2002@gmail.com"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Štrumbelj, Erik"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Ljubljana"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"erik.strumbelj@fri.uni-lj.si"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Trojer, Sebastijan"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Ljubljana"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"st5804@student.uni-lj.si"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Mervič, Žan"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Ljubljana"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"zan.mervic@gmail.com"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<h2>Dataset Description</h2>\n\n<p>\nThis dataset is developed for <strong>dog re-identification (Re-ID)</strong> across videos and images. It contains <strong>7,463 videos</strong> of <strong>1,553 distinct dog identities</strong> (averaging 4.8 videos/dog). Bounding boxes are manually annotated on the first frame of each video to support the training or fine-tuning of dog detectors. \n</p>\n\n<h3>Benchmark, Leaderboard & Baseline</h3>\n<p>\nTo facilitate ongoing research and provide a standard starting point, we have established a public benchmark alongside this dataset. We provide a baseline model implementation, and we host an active leaderboard to track state-of-the-art methods.\n</p>\n<ul>\n  <li><strong>Leaderboard:</strong> <a href=\"https://project-puppies.com/leaderboard\">Submit your results and view current rankings</a>.</li>\n  <li><strong>Baseline Implementation:</strong> Check out our <a href=\"https://github.com/markoMedved/DogReID-1553\">GitHub repository</a> for the starter code and Re-ID pipeline.</li>\n  <li><strong>Paper:</strong> Detailed methodology and baseline evaluation (under review).</li>\n</ul>\n\n<h3>Data Collection</h3>\n<p>\nTo avoid the restrictive licensing of scraped social media data, videos were crowdsourced directly from users via our <a href=\"https://project-puppies.com/\">submission website</a> using community promotion (Reddit, Discord, Instagram) and the Prolific research platform. All submitters explicitly agreed to release their videos under the permissive <strong>Creative Commons CC0 1.0</strong> license.\n</p>\n\n<h3>Pre-processing and Anonymization</h3>\n<p>\nVideos were converted to <strong>MP4 (H.264)</strong>, stripped of audio, and temporally cropped so the target dog is clearly visible in the first frame. \nTo ensure privacy, all videos were manually reviewed. We used video editing software to permanently black out sensitive information (faces, license plates, tattoos, addresses) from the dataset.\n</p>\n\n<h3>Data Leakage Prevention</h3>\n<p>\nTo prevent models from overfitting to environmental cues (e.g., memorizing a specific backyard instead of the dog), the gallery and query sets are <strong>scene-disjoint</strong>. Videos for each identity were manually partitioned to ensure zero background overlap between query and gallery splits.\n</p>\n\n<h3>Directory Structure</h3>\n\n<p>Files are organized by unique UUIDs (<code>DOG_ID</code> and <code>VIDEO_ID</code>):</p>\n\n<ul>\n  <li>\n    <strong>/Videos/</strong> — Contains the <code>.mp4</code> files.\n    <pre><code>/Videos/DOG_ID/DOG_ID-VIDEO_ID.mp4</code></pre>\n    Example:\n    <pre><code>/Videos/00ab4db8-3e94-44e3-a4b1-9fe316c67b60/00ab4db8-3e94-44e3-a4b1-9fe316c67b60-2cc7b112-2af8-4466-931a-c83a2466d81a.mp4</code></pre>\n  </li>\n  <li>\n    <strong>/Images/</strong> — Contains the <code>.jpg</code> first-frame crops.\n    <pre><code>/Images/DOG_ID/DOG_ID-VIDEO_ID.jpg</code></pre>\n    Example:\n    <pre><code>/Images/00ab4db8-3e94-44e3-a4b1-9fe316c67b60/00ab4db8-3e94-44e3-a4b1-9fe316c67b60-2cc7b112-2af8-4466-931a-c83a2466d81a.jpg</code></pre>\n  </li>\n</ul>\n\n<h3>Annotations and Metadata</h3>\n\n<ul>\n  <li> \n    <strong>bounding_boxes.csv</strong> — Top-left coordinates and dimensions (in pixels) for the first-frame bounding boxes. \n    <pre><code>DOG_ID,VIDEO_ID,x_top_left,y_top_left,width,height\n0062cada-a402-41bb-980e-6ae5e0672440,3f13a35c-be97-4331-b1f9-503bf4628e00,3,259,459,503</code></pre>\n  </li>\n  <li>\n    <strong>breeds.csv</strong> — User-submitted dog breeds.\n    <pre><code>DOG_ID,BREED\n10541c3c-42f8-4c22-b974-5032add36da4,AlaskanMalamute</code></pre>\n  </li>\n  <li>\n    <strong>splits.csv</strong> — Defines the train-gallery-query splits. The <code>GROUP</code> column enforces the scene-disjoint subsets.\n    <pre><code>DOG_ID,VIDEO_ID,GROUP,SPLIT_CLOSED_SET,SPLIT_OPEN_SET\n0062cada-a402-41bb-980e-6ae5e0672440,4f82f8da-1e3f-46f8-b48a-3a161d52cdf0,0,gallery,query</code></pre>\n  </li>\n</ul>\n\n<h3>Evaluation Splits Summary</h3>\n\n<p>\n    The dataset is divided into two primary evaluation settings. For both, the <strong>Total number of Videos</strong> are shown first, followed by the number of unique <strong>Identities</strong> in parentheses.\n</p>\n\n<div style=\"margin-bottom: 20px;\">\n    <strong>1. Closed-world Setting</strong>\n    <p><em>Goal: Identify a dog from a set where every query identity is guaranteed to exist in the gallery.</em></p>\n    <ul>\n        <li><strong>Train Set:</strong> 3,788 Videos (776 IDs) </li>\n        <li><strong>Gallery Set:</strong> 1,998 Videos (777 IDs) .</li>\n        <li><strong>Query Set:</strong> 1,677 Videos (680 IDs) </li>\n    </ul>\n</div>\n\n<div>\n    <strong>2. Open-world Setting</strong>\n    <p><em>Goal: Identify a dog while also determining if the dog even exists in the gallery at all.</em></p>\n    <ul>\n        <li><strong>Train Set:</strong> 3,708 Videos (766 IDs) </li>\n        <li><strong>Gallery Set:</strong> 1,296 Videos (512 IDs)</li>\n        <li><strong>Query Set:</strong> 2,459 Videos (777 IDs) </li>\n    </ul>\n</div>\n<h3>File Formats</h3>\n<ul>\n    <li><strong>Videos:</strong> <code>.mp4</code></li>\n    <li><strong>Images:</strong> <code>.jpg</code></li>\n    <li><strong>Metadata, splits, and annotations:</strong> <code>.csv</code></li>\n</ul>"},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-11-01"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Computer and Information Science"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Video Dog Re-Identification"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"All human subject data included in this dataset have been anonymized prior to submission. No personally identifiable information is included."},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Medved, Marko"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2025-10-31"}]}},"files":[{"label":"bounding_boxes.tab","restricted":false,"version":1,"datasetVersionId":729962,"dataFile":{"id":13712995,"persistentId":"","filename":"bounding_boxes.tab","contentType":"text/tab-separated-values","friendlyType":"Tab-Delimited","filesize":698387,"storageIdentifier":"s3://dvn-cloud-iqss:19dce8fb378-cd5d843cbaab","originalFileFormat":"text/comma-separated-values","originalFormatLabel":"Comma Separated Values","originalFileSize":675999,"originalFileName":"bounding_boxes.csv","UNF":"UNF:6:TbF13ZflSPvEL/mCYZW/Pg==","rootDataFileId":-1,"md5":"98b14c93bf6229b6571a61cdc586d0b5","checksum":{"type":"MD5","value":"98b14c93bf6229b6571a61cdc586d0b5"},"tabularData":true,"creationDate":"2026-04-27","publicationDate":"2026-04-27","lastUpdateTime":"2026-05-06T18:41:13Z","fileAccessRequest":true}},{"label":"breeds.tab","restricted":false,"version":1,"datasetVersionId":729962,"dataFile":{"id":13765825,"persistentId":"","filename":"breeds.tab","contentType":"text/tab-separated-values","friendlyType":"Tab-Delimited","filesize":80860,"storageIdentifier":"s3://dvn-cloud-iqss:19dec5e241b-ade7538d580f","originalFileFormat":"text/comma-separated-values","originalFormatLabel":"Comma Separated Values","originalFileSize":76202,"originalFileName":"breeds-1.csv","UNF":"UNF:6:CIAUWEcUMzm7rz0LsS9KpQ==","rootDataFileId":-1,"md5":"1e50f90472ce081f2e80b7853cc74d58","checksum":{"type":"MD5","value":"1e50f90472ce081f2e80b7853cc74d58"},"tabularData":true,"creationDate":"2026-05-03","publicationDate":"2026-05-03","lastUpdateTime":"2026-05-06T18:41:13Z","fileAccessRequest":true}},{"label":"Images.zip","restricted":false,"version":1,"datasetVersionId":729962,"dataFile":{"id":13652926,"persistentId":"","filename":"Images.zip","contentType":"application/zip","friendlyType":"ZIP Archive","filesize":1522193529,"storageIdentifier":"s3xxxxl://dvn-cloud-iqss:19d62ea27b9-27ece9605b5d","rootDataFileId":-1,"md5":"f4b70725c4e569a2728d4afe6cae9268","checksum":{"type":"MD5","value":"f4b70725c4e569a2728d4afe6cae9268"},"tabularData":false,"creationDate":"2026-04-06","publicationDate":"2026-04-17","lastUpdateTime":"2026-05-06T18:41:13Z","fileAccessRequest":true}},{"label":"splits.tab","restricted":false,"version":1,"datasetVersionId":729962,"dataFile":{"id":13670578,"persistentId":"","filename":"splits.tab","contentType":"text/tab-separated-values","friendlyType":"Tab-Delimited","filesize":723090,"storageIdentifier":"s3://dvn-cloud-iqss:19d8f026f53-7214948b362a","originalFileFormat":"text/comma-separated-values","originalFormatLabel":"Comma Separated Values","originalFileSize":670850,"originalFileName":"splits.csv","UNF":"UNF:6:SoaYekNHJ91BZcwGZYQ0Rg==","rootDataFileId":-1,"md5":"7331eb109778af680ede11d347d5c751","checksum":{"type":"MD5","value":"7331eb109778af680ede11d347d5c751"},"tabularData":true,"creationDate":"2026-04-14","publicationDate":"2026-04-17","lastUpdateTime":"2026-05-06T18:41:13Z","fileAccessRequest":true}},{"label":"Videos.zip","restricted":false,"version":1,"datasetVersionId":729962,"dataFile":{"id":13653939,"persistentId":"","filename":"Videos.zip","contentType":"application/zip","friendlyType":"ZIP Archive","filesize":65539679181,"storageIdentifier":"s3xxxxl://dvn-cloud-iqss:19d66dc7883-228a3b326cec","rootDataFileId":-1,"md5":"9309949d3d7470f9ecb785d0ae59669c","checksum":{"type":"MD5","value":"9309949d3d7470f9ecb785d0ae59669c"},"tabularData":false,"creationDate":"2026-04-07","publicati